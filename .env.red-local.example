# ---------------------------------------------------------------
# CEPRE UNU - Configuracion para red local (Windows, IP estatica)
# ---------------------------------------------------------------
# Copie este archivo como .env en el equipo servidor y ajuste:
#   - APP_URL con la IP estatica y el puerto del servidor
#   - DB_* con los datos de MySQL
# El script iniciar-red-local.ps1 actualiza APP_URL automaticamente.
# ---------------------------------------------------------------

APP_NAME="CEPRE UNU"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.50:8000
APP_VERSION=1.0.0

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL en el mismo equipo servidor.
# Herd Pro suele usar el puerto 3307; MySQL instalado aparte, el 3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unu_db_cepre
DB_USERNAME=root
DB_PASSWORD=

# Sesiones y cache en archivos: el proyecto no tiene migraciones
# para las tablas "sessions" ni "cache".
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Debe quedar en false mientras se acceda por http:// (sin certificado).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="cepre@unu.edu.pe"
MAIL_FROM_NAME="${APP_NAME}"

URL_API_RENIEC=
TOKEN_API_RENIEC=
RENIEC_ALLOW_INSECURE_SSL=false

VITE_APP_NAME="${APP_NAME}"
