# Copie este archivo como docker/.env y cambie las contrasenas.
# docker/.env no se sube al repositorio.

# Contrasena del usuario root de MySQL (solo administracion).
MYSQL_ROOT_PASSWORD=cambiar_root

# Base de datos y usuario que usara Laravel.
MYSQL_DATABASE=unu_db_cepre
MYSQL_USER=cepre_unu
MYSQL_PASSWORD=cambiar_clave

# Puerto en este equipo. Si ya hay otro MySQL usando 3306 (por ejemplo,
# el de Herd o XAMPP), use otro puerto, como 3307, y pongalo en DB_PORT.
MYSQL_PORT=3306

# 127.0.0.1 = solo este equipo (recomendado). 0.0.0.0 = toda la red.
MYSQL_BIND=127.0.0.1
